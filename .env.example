# Test values for local development only. Optional: every one is also the default in
# docker-compose.yml, so copy this to .env only to change them.
LEDGER_DB_HOST=db
LEDGER_DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin_test_pw
LEDGER_RO_PASSWORD=ro_test_pw
LEDGER_RW_PASSWORD=rw_test_pw
# Leave empty to replay recordings. Needed only for LEDGER_LLM_MODE=live or record.
LEDGER_LLM_MODE=replay
# Empty uses claude-sonnet-5-5. claude-haiku-5-5 replays the earlier Haiku baseline.
LEDGER_MODEL=
ANTHROPIC_API_KEY=
